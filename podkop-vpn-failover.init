#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/podkop-vpn-failover"

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param respawn 3600 5 5
    # The daemon may be sleeping for CHECK_INTERVAL=30s when SIGTERM arrives.
    # Give the shell enough time to leave sleep, run its trap and remove the lock.
    procd_set_param term_timeout 45
    # The worker writes structured events through logger(1). Do not also
    # redirect its diagnostic stderr/stdout into logd, otherwise each event
    # is duplicated and stderr copies are incorrectly tagged as daemon.err.
    procd_close_instance
}

reload_service() {
    stop
    start
}
