#!/bin/sh
umask 077

# podkop-vpn-failover
# AmneziaWG recovery for Podkop, Forkop and Forkozz/NetShift on OpenWrt.

VERSION="0.3.0-dev.2"
TAG="podkop-vpn-failover"

# Health-check settings.
CHECK_INTERVAL=30
CONNECT_TIMEOUT=5
MAX_TIME=10
FAIL_THRESHOLD=3
CANDIDATE_SUCCESS_THRESHOLD=2
CANDIDATE_RETRY_DELAY=1
POST_SWITCH_DELAY=4

# Give OpenWrt and the routing backend and the VPN interfaces time to settle after this daemon
# starts. No automatic failover is allowed during this window.
STARTUP_GRACE_PERIOD=120

# After a complete reserve scan finds no healthy VPN, avoid repeatedly testing
# the whole pool. The current VPN may still be probed every CHECK_INTERVAL so a
# quick self-recovery is noticed without waiting for the full retry interval.
NO_RESERVE_RETRY_INTERVAL=300

# A recently failed interface is temporarily deprioritized. If no other
# healthy reserve exists, quarantined interfaces are still tested as a
# last-resort recovery path.
QUARANTINE_SECONDS=180

STATE_DIR="/tmp/${TAG}"
LOCK_DIR="/tmp/${TAG}.lock"
PID_FILE="${STATE_DIR}/pid"
FAIL_FILE="${STATE_DIR}/failures"
LAST_SWITCH_FILE="${STATE_DIR}/last-switch"
NO_RESERVE_UNTIL_FILE="${STATE_DIR}/no-reserve-until"
SING_BOX_CONFIG="/etc/sing-box/config.json"
INIT_SERVICE="/etc/init.d/podkop-vpn-failover"
PODKOP_INIT="/etc/init.d/podkop"
SING_BOX_INIT="/etc/init.d/sing-box"

PROBE_HTTP="000"
PROBE_TIME="0"
PROBE_RC=1
FOREGROUND=0
BACKEND=""
SECTION="main"
CONFIG_PACKAGE=""
BACKEND_ERROR=""
HISTORY_FILE="${STATE_DIR}/operations.tsv"
HISTORY_LIMIT=200

say() { printf '%s\n' "$*"; }
ensure_state_dir() {
    [ ! -L "$STATE_DIR" ] || return 1
    [ -d "$STATE_DIR" ] || mkdir -m 700 "$STATE_DIR" || return 1
    trusted_directory "$STATE_DIR"
}
RECOVERY_LIB="${PVF_RECOVERY_LIB:-/usr/lib/podkop-vpn-failover/recovery.sh}"
[ -r "$RECOVERY_LIB" ] || { say "Recovery library missing; reinstall complete package." >&2; exit 2; }
. "$RECOVERY_LIB"
select_backend || :
case "${1:-}" in
    daemon) run_daemon ;;
    recover) cycle ;;
    cancel)
        ensure_state_dir || exit 1
        printf '%s-%s\n' "$(monotonic)" "$$" > "$STATE_DIR/cancel-generation" ;;
    cleanup) acquire_operation && release_operation ;;
    pause) pause_control 1 ;;
    resume) pause_control 0 ;;
    reset)
        acquire_operation || exit 2
        reset_counters
        release_operation ;;
    status) show_status ;;
    identity) say "$(backend_label)" ;;
    dashboard) show_dashboard ;;
    test) show_test ;;
    check)
        valid_name "${2:-}" || exit 2
        acquire_operation || exit 2
        CURRENT="$(get_current_interface)"
        if [ "$2" != "$CURRENT" ] && ! allowed_interface "$2"; then release_operation; exit 2; fi
        probe_interface "$2"; rc=$?
        backend_line "$2: $PROBE_CODE"
        release_operation
        exit "$rc" ;;
    history) [ ! -r "$HISTORY_FILE" ] || cat "$HISTORY_FILE" ;;
    logs) [ ! -r "$HISTORY_FILE" ] || tail -n 100 "$HISTORY_FILE" ;;
    config) show_config ;;
    version|--version|-V) say "$VERSION" ;;
    *) say "Usage: $0 daemon|recover|pause|resume|reset|status|dashboard|test|check IFACE|history|logs|config|version" ;;
esac
