#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/podkop-vpn-failover"

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param respawn 3600 5 5
    # The daemon may be sleeping for CHECK_INTERVAL=30s when SIGTERM arrives.
    # Give the shell enough time to leave sleep, run its trap and remove the lock.
    procd_set_param term_timeout 45
    # Operation events are kept in the bounded private recovery journal.
    # Backend/sing-box keep their own native procd/logd logging.
    procd_close_instance
}

reload_service() {
    stop
    start
}

stop_service() {
    # Cancel explicit UI/CLI recovery as well as the supervised daemon.
    "$PROG" cancel >/dev/null 2>&1 || :
}
